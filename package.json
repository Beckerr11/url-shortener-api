{
  "name": "url-shortener-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "docker:build": "docker build -t url-shortener-api .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "url-shortener",
    "express",
    "api",
    "jest",
    "supertest"
  ],
  "license": "ISC",
  "description": "Functional URL shortener API demo with validation, aliases, redirects, basic analytics, tests and Docker.",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
